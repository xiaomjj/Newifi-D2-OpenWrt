#!/bin/sh
[ -n "$INTERFACE" ] || exit 0

case "$INTERFACE" in
  usb*|eth1|eth2) ;;
  *) exit 0 ;;
esac

is_usb_dev() {
  if [ -e "/sys/class/net/$INTERFACE/device/uevent" ]; then
    grep -q "DEVTYPE=usb_interface" "/sys/class/net/$INTERFACE/device/uevent" 2>/dev/null && return 0
    readlink -f "/sys/class/net/$INTERFACE/device" 2>/dev/null | grep -q usb && return 0
  else
    readlink -f "/sys/class/net/$INTERFACE/device" 2>/dev/null | grep -q usb && return 0
  fi
  return 1
}

find_wan_zone() {
  uci show firewall 2>/dev/null | grep -E "zone\[[0-9]+\]\.name='wan'" | head -1 | sed -n "s/.*zone\[\([0-9]*\)\].*/\1/p"
}

case "$ACTION" in
  add)
    is_usb_dev || exit 0
    uci get network.usbwan >/dev/null 2>&1 && exit 0
    uci set network.usbwan=interface
    uci set network.usbwan.proto='dhcp'
    uci set network.usbwan.device="$INTERFACE"
    uci set network.usbwan.metric='10'
    uci commit network
    WAN_ZONE=$(find_wan_zone)
    if [ -n "$WAN_ZONE" ]; then
      uci add_list firewall.@zone[$WAN_ZONE].network='usbwan' 2>/dev/null
      uci commit firewall
    fi
    /etc/init.d/network reload
    /etc/init.d/firewall reload
    ;;
  remove)
    CUR_DEV=$(uci get network.usbwan.device 2>/dev/null)
    [ "$CUR_DEV" = "$INTERFACE" ] || exit 0
    uci delete network.usbwan 2>/dev/null
    uci commit network
    WAN_ZONE=$(find_wan_zone)
    if [ -n "$WAN_ZONE" ]; then
      uci del_list firewall.@zone[$WAN_ZONE].network='usbwan' 2>/dev/null
      uci commit firewall
    fi
    /etc/init.d/network reload
    /etc/init.d/firewall reload
    ;;
esac
