config globals
    option workgroup 'WORKGROUP'
    option description 'Newifi-D2'
    option allow_legacy_protocols '1'

config share
    option name 'usb'
    option path '/mnt'
    option read_only 'no'
    option guest_ok 'yes'
    option create_mask '0666'
    option dir_mask '0777'
    option force_root '1'
