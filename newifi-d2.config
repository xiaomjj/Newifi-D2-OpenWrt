# ============================================================
#  LEDE 精简稳定版 — Newifi-D2
#  设备: Newifi-D2 (MT7621 / 32MB Flash / 512MB RAM)
#  代理: PassWall(Xray) + Iptables 透明代理
#  存储: block-mount 原生挂载点 (exFAT / NTFS / FAT32 / ext4)
#  USB:  USB 2.0 + USB 3.0 (xHCI, MT7621)
# ============================================================

# ---------- 1. 目标硬件 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ---------- 2. 系统与中文界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_LUCI_DEFAULT_LANG="zh_cn"
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ---------- 3. 基础网络 (原生 iptables 栈) ----------
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ---------- 4. ZRAM 防 OOM ----------
CONFIG_PACKAGE_zram-swap=y

# ---------- 5. PassWall 代理 (Xray + Iptables) ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy is not set

CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-zz-legacy=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-socket=y

CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y

# ---------- 6. USB 共享网络 (手机 RNDIS/CDC/iPhone) ----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y

# ---------- 7. 无线中继 (WWAN) ----------
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y

# ---------- 8. 实用工具 ----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y

# ============================================================
# 9. USB 存储：block-mount 原生挂载点方案
# ============================================================

# 核心 USB 存储驱动
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# USB 3.0 xHCI 控制器 (MT7621 内置)
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y

# 核心挂载管理：启用 LuCI “系统 → 挂载点”及自动挂载脚本
CONFIG_PACKAGE_block-mount=y

# ---- 文件系统内核驱动 ----
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# ntfs-3g 为用户态 FUSE 驱动，依赖 kmod-fuse
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_kmod-fuse=y

# ---- 格式化工具 (SSH 下按需使用) ----
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_dosfstools=y

# 编码模块 (中文文件名)
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y

# ============================================================
# 10. 剔除的组件
# ============================================================
# CONFIG_PACKAGE_luci-app-diskman is not set
# CONFIG_PACKAGE_kmod-fs-exfat-oot is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-automount is not set
# CONFIG_PACKAGE_luci-app-watchcat is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-wol is not set
