# ============================================================
#  ImmortalWrt (openwrt-24.10) 定制配置 - 终极全能版
#  设备: Newifi-D2 (MT7621 / 32MB 闪存)
#  特性: 满血 PassWall + NTFS + 无线中继 + 完善路由工具
# ============================================================

# ---------- 1. 目标硬件 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ---------- 2. 基础系统与中文界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_LUCI_DEFAULT_LANG="zh_cn"

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ---------- 3. 基础网络 ----------
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ---------- 4. PassWall 满血版 ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ---------- 5. 完整 USB 存储与文件系统 (支持 NTFS) ----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_luci-app-automount=y

# ---------- 6. 无线中继 (WWAN Relay) ----------
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y

# ---------- 7. 路由器进阶与实用功能 ----------
# 内网限速 (基于 nftables 的轻量级流控)
CONFIG_PACKAGE_luci-app-eqos=y
# 实时流量监控与统计
CONFIG_PACKAGE_luci-app-nlbwmon=y
# 定时开关 WiFi
CONFIG_PACKAGE_luci-app-wifischedule=y
# 轻量级 FTP 文件共享 (替代庞大的 Samba)
CONFIG_PACKAGE_luci-app-vsftpd=y
# UPnP (BT下载/游戏联机)
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
# 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y
# 自愈：看门狗、定时重启、ARP绑定
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-arpbind=y
# DDNS、TTYD
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-dnspod-v3=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 网络诊断工具 (命令行，无界面，体积极小)
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_tcpdump=y

# ---------- 8. 坚决剔除的冗余组件 ----------
# 4G/5G 拨号模块
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-mbim is not set
# CONFIG_PACKAGE_umbim is not set
# CONFIG_PACKAGE_luci-proto-qmi is not set
# CONFIG_PACKAGE_luci-proto-mbim is not set
# CONFIG_PACKAGE_kmod-usb-net-rndis is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ether is not set
# CONFIG_PACKAGE_luci-proto-ncm is not set
# 易死机加速与超大体积组件
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
