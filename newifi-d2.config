# ============================================================
#  ImmortalWrt 24.10 + PassWall(Xray) + TurboACC —— newifi-d2
#  目标分支: openwrt-24.10 (ramips/mt7621, 内核 6.6)
#  为何是 24.10 而不是 25.12：25.12 在 mt7621 有 MT7530 FDB 失步回归
#  （openwrt#25305，Wi-Fi 漫游后 TCP 断流，DNS/ping 却正常）；24.10 LTS 无此问题。
#  说明: 本文件只写"真实存在"的 Kconfig 符号；不存在的符号会被
#        make defconfig 静默丢弃，本仓库 workflow 会做硬性校验。
# ============================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---------- 构建选项 ----------
# ccache 不打开的话，workflow 里缓存 .ccache 完全是空转
CONFIG_CCACHE=y
# 小闪存必开：剥离内核用不到的导出符号
CONFIG_STRIP_KERNEL_EXPORTS=y

# ---------- LuCI 与中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
# 默认语言不用 CONFIG_LUCI_DEFAULT_LANG（不是 Kconfig 符号），
# 由 files/etc/uci-defaults/90-luci 写 uci luci.main.lang 实现

# ---------- 基础网络 ----------
CONFIG_PACKAGE_luci-app-firewall=y
# 下面这几个本就在 DEFAULT_PACKAGES.router / DEFAULT_PACKAGES 里，显式写出只为
# 一眼能审计到：firewall4 + nftables 是 PassWall nftables 模式的地基，
# uclient-fetch + libustream-openssl 是 rule-refresh 手动刷规则的 HTTPS 下载通道。
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_libustream-openssl=y
# dnsmasq-full：MosDNS 在前、dnsmasq 只做缓存与下发，但审计按 full 校验，且要 --conf-dir
CONFIG_PACKAGE_dnsmasq-full=y
# 上游加密改由 MosDNS 的 DoH 负责（dnsmasq 只做缓存与转发），不再需要编 DNSSEC
CONFIG_PACKAGE_dnsmasq_full_dnssec=n
# ★ dnsmasq 的 nftset 是 PassWall 域名分流的地基：它把 gfwlist / proxy_host 里的域名
# 解析结果写进 nft 集合 psw_gfw，nftables 才能按 IP 决定直连还是走 TPROXY。
# 25.12.16 的 Makefile 是 `+PACKAGE_dnsmasq_full_nftset:nftables-json`，上游若改默认值会静默失效，
# 所以这里显式写 y（也顺带把 nftables-json 拉进来）。
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# MosDNS 的 DoH 要校验证书：没有 CA 包会一直校验失败、退回明文（省不得）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：ipv6helper 上游已删除，改用原生组件
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ---------- 无线 ----------
# 这两个包平时由目标 profile 的 DEFAULT_PACKAGES 带入，但"默认带上"不等于"一定有"：
# 缺 wireless-regdb 时 country=CN 会设置失败，cfg80211 只能退回 world 法规域 ——
# 2.4G 发射功率被压到很低（穿墙更差），5G 部分信道直接不可用（时有时无）。
CONFIG_PACKAGE_wireless-regdb=y
# iw：wifi-doctor 诊断、手动切信道都要用（约 60KB，值得带）
CONFIG_PACKAGE_iw=y

# ---------- TurboACC（luci feed 已无此包，workflow 从上游克隆） ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
# 全锥 NAT 依赖 kmod-nft-fullcone，feeds 不一定有；确认存在后再改 y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV=n
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---------- 内存防溢出 ----------
# zram-swap 是 core 包，依赖里自带 kmod-zram
CONFIG_PACKAGE_zram-swap=y

# ---------- 代理：PassWall + Xray（透明代理；DNS 仍归 MosDNS） ----------
# luci-app-passwall 由官方 luci feed 提供（openwrt-24.10 分支 = 25.12.16），不必外挂第三方源。
# ★ 下面每个符号都对照过 25.12.16 的 Makefile：这一版已经没有 Nftables/Iptables_Transparent_Proxy
#   开关（它自己按 fw4 + dnsmasq nftset 判断），也没有 INCLUDE_SmartDNS / INCLUDE_Geoview /
#   INCLUDE_ShadowsocksR_Libev_Client —— 写不存在的符号会被 make defconfig 静默丢弃，
#   workflow 的「关键组件校验」随即误报缺件、把构建卡死，所以这里只写真实存在的。
CONFIG_PACKAGE_luci-app-passwall=y
# 中文界面（不选就是英文；只有几十 KB）
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# 核心只留 Xray：vmess / vless(+reality) / trojan / shadowsocks / socks / http 都由它一个二进制覆盖，
# 其余插件（Hysteria/Naive/ShadowTLS/ss-rust/ssr/v2ray-plugin/xray-plugin/SingBox）全关，
# 既省闪存（ss-rust 单个就 3.9MB），也避免把用不到的守护进程塞进 31.7MB 的固件分区。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
# geoip/geosite 一律不编：v2ray-geoip 装完 23.3MB、v2ray-geosite 2.3MB，
# 而这台机器的固件分区只有 31.7MiB。「绕过大陆」靠包自带的 chnroute/chnlist 文本规则
# （随包发布，约 1.5MB），只有 PassWall 的「分流节点(_shunt)」才要 geoip.dat/geosite.dat，
# 用到时在 LuCI「规则列表」里点更新即可。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=n
CONFIG_PACKAGE_xray-core=y
# 关于 ss:// 链接：PassWall 的「SS」节点类型调的是 ss-local/sslocal（由 ss-rust 提供，3.9MB），
# 本固件不装它；需要 ss 节点时用「Xray」节点类型里的 shadowsocks 协议（页面里可选），
# 或在「系统 → 软件包」里手动装 shadowsocks-rust-sslocal。
# chinadns-ng / dns2socks：PassWall 的 DNS 分流组件（默认 dns_shunt=chinadns-ng 时用），
# 合计约 0.7MB；缺了 LuCI 的「DNS」页会红字报错，装上更省心。
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
# nftables 透明代理地基：PassWall 的 nft 规则集 + TProxy 需要它们
# ip-full：PassWall 的 nftables.sh 要用 ip rule / ip route 做策略路由，busybox 的 ip 对 table 支持不全
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
# kmod-tun：PassWall 的 TUN 模式（本固件用 TPROXY，保留只是防止以后想切 TUN 还要重编内核）
CONFIG_PACKAGE_kmod-tun=y
# MosDNS：去广告（域名集合）+ 上游加密（DoH）都靠它，显式写出便于审计。
# 只装二进制包；luci-app-mosdns 不装（它的依赖会把 10.9MB 的 geosite.dat 拉回来）
CONFIG_PACKAGE_mosdns=y

# ---------- USB 存储与局域网共享 (ksmbd) ----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# 国内 U 盘常见的 GBK 文件名
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# ---------- USB 网络共享 / 随身 WiFi ----------
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbmuxd=y

# ---------- USB 打印 (p910nd) ----------
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
