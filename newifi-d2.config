# ============================================================
#  ImmortalWrt 24.10 + sing-box + TurboACC —— newifi-d2
#  目标分支: openwrt-24.10 (ramips/mt7621, 内核 6.6)
#  为何是 24.10 而不是 25.12：25.12 在 mt7621 有 MT7530 FDB 失步回归
#  （openwrt#25305，Wi-Fi 漫游后 TCP 断流，DNS/ping 却正常）；24.10 LTS 无此问题。
#  说明: 本文件只写"真实存在"的 Kconfig 符号；不存在的符号会被
#        make defconfig 静默丢弃，本仓库 workflow 会做硬性校验。
# ============================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---------- 构建选项 ----------
# ccache 不打开的话，workflow 里缓存 .ccache 完全是空转
CONFIG_CCACHE=y
# 小闪存必开：剥离内核用不到的导出符号
CONFIG_STRIP_KERNEL_EXPORTS=y

# ---------- LuCI 与中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
# 默认语言不用 CONFIG_LUCI_DEFAULT_LANG（不是 Kconfig 符号），
# 由 files/etc/uci-defaults/90-luci 写 uci luci.main.lang 实现

# ---------- 基础网络 ----------
CONFIG_PACKAGE_luci-app-firewall=y
# 下面这几个本就在 DEFAULT_PACKAGES.router / DEFAULT_PACKAGES 里，显式写出只为
# 一眼能审计到：firewall4 + nftables 是 sing-box TProxy 的地基，
# uclient-fetch + libustream-openssl 是 rule-refresh 手动刷规则的 HTTPS 下载通道。
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_libustream-openssl=y
# dnsmasq-full：MosDNS 在前、dnsmasq 只做缓存与下发，但审计按 full 校验，且要 --conf-dir
CONFIG_PACKAGE_dnsmasq-full=y
# 上游加密改由 MosDNS 的 DoH 负责（dnsmasq 只做缓存与转发），不再需要编 DNSSEC
CONFIG_PACKAGE_dnsmasq_full_dnssec=n
# nftset 现在已经没有使用者（sing-box 用嗅探 + ip_cidr 分流，不往 nft 集合里写域名），
# 保持上游默认 y，只是不想因为这里改 n 而牵动 dnsmasq 的依赖链。
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# MosDNS 的 DoH 要校验证书：没有 CA 包会一直校验失败、退回明文（省不得）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：ipv6helper 上游已删除，改用原生组件
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ---------- 无线 ----------
# 这两个包平时由目标 profile 的 DEFAULT_PACKAGES 带入，但"默认带上"不等于"一定有"：
# 缺 wireless-regdb 时 country=CN 会设置失败，cfg80211 只能退回 world 法规域 ——
# 2.4G 发射功率被压到很低（穿墙更差），5G 部分信道直接不可用（时有时无）。
CONFIG_PACKAGE_wireless-regdb=y
# iw：wifi-doctor 诊断、手动切信道都要用（约 60KB，值得带）
CONFIG_PACKAGE_iw=y

# ---------- TurboACC（luci feed 已无此包，workflow 从上游克隆） ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
# 全锥 NAT 依赖 kmod-nft-fullcone，feeds 不一定有；确认存在后再改 y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV=n
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---------- 内存防溢出 ----------
# zram-swap 是 core 包，依赖里自带 kmod-zram
CONFIG_PACKAGE_zram-swap=y

# ---------- sing-box（透明代理，取代 PassWall + Xray） ----------
# 只装官方 feeds 里的 sing-box 二进制：单文件覆盖 vmess/vless/trojan/shadowsocks/
# hysteria/hysteria2/tuic/anytls/socks/http，自带 tproxy 入站，不需要 jq/lua 运行期依赖。
# 管理面是固件自带的 singbox-ctl + 一个 LuCI JS 视图（见 workflow C4 节），
# 所以这里不装任何 passwall / ssr-plus / luci-app-sing-box 包。
#
# 选 tiny 变体而不是 full：full 的 ipk 14.3MB（装完 46MB），tiny 默认 8.7MB，
# 而 Newifi D2 的固件分区只有 31.7MB，塞 full 会把 overlay 挤死。
# 下面 5 个构建标签补回 tiny 默认不带的协议能力，协议覆盖仍与 full 对齐：
#   QUIC      → hysteria2 / tuic / h3 DNS
#   UTLS      → vless + reality（指纹伪装）
#   GRPC      → vmess/vless 的 gRPC 传输
#   WIREGUARD → wireguard 出站（mipsel 上默认不编）
#   CLASH_API → 面板与测速 API（tiny 默认已开，显式写出防止上游改默认）
# 不编：acme（证书签发）、dhcp（dhcp 出站）、tailscale（体积巨大）、v2ray_api、embedded_tor
CONFIG_PACKAGE_sing-box-tiny=y
CONFIG_SING_BOX_TINY_BUILD_QUIC=y
CONFIG_SING_BOX_TINY_BUILD_UTLS=y
CONFIG_SING_BOX_TINY_BUILD_GRPC=y
CONFIG_SING_BOX_TINY_BUILD_WIREGUARD=y
CONFIG_SING_BOX_TINY_BUILD_CLASH_API=y
# nftables 透明代理地基：prerouting 命中的转发流量 tproxy 到 sing-box，并打 mark 走策略路由
# （路由器自身出站不拦，所以不需要 output 链）
# ip-full：singbox-fw 要用 ip rule / ip route table 100 做策略路由。
# busybox 的 ip 在小版本里对 table 支持不全，缺它会出现「nft 装好了但流量进不来」，
# 所以显式换成 ip-full（约 100KB）。
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
# MosDNS：去广告（域名集合）+ 上游加密（DoH）都靠它，显式写出便于审计。
# 只装二进制包；luci-app-mosdns 不装（它的依赖会把 10.9MB 的 geosite.dat 拉回来）
CONFIG_PACKAGE_mosdns=y
# kmod-tun 当前没用到（本固件走 tproxy，不做 tun 全局模式）；留着是为了以后想加 tun 入站
# 时不用改内核。kmod-inet-diag 是 sing-box-tiny 自己的依赖，显式写出便于审计。
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

# ---------- GeoData：不编入（轻量化，已移除）----------
# 本固件不装 v2ray-geoip / v2ray-geosite（前者 22.2MB、后者 10.9MB 安装体积），
# 分流只用文本规则：gfwlist（域名后缀）+ chnroute（国内 CIDR），构建期写进镜像。
# 想上二进制规则集（.srs）：singbox-ctl 目前只渲染文本规则，页面没有 .srs 入口；
# 要用得自己往 config.json 里加 rule_set（apply 会被重新渲染覆盖，需要改 singbox-ctl）。

# ---------- USB 存储与局域网共享 (ksmbd) ----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# 国内 U 盘常见的 GBK 文件名
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# ---------- USB 网络共享 / 随身 WiFi ----------
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbmuxd=y

# ---------- USB 打印 (p910nd) ----------
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
