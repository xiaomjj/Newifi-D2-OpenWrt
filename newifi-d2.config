# ============================================================
#  ImmortalWrt 25.12 + PassWall + TurboACC —— newifi-d2
#  目标分支: openwrt-25.12 (ramips/mt7621)
#  说明: 本文件只写"真实存在"的 Kconfig 符号；不存在的符号会被
#        make defconfig 静默丢弃，本仓库 workflow 会做硬性校验。
# ============================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---------- 构建选项 ----------
# ccache 不打开的话，workflow 里缓存 .ccache 完全是空转
CONFIG_CCACHE=y
# 小闪存必开：剥离内核用不到的导出符号
CONFIG_STRIP_KERNEL_EXPORTS=y

# ---------- LuCI 与中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
# 默认语言不用 CONFIG_LUCI_DEFAULT_LANG（不是 Kconfig 符号），
# 由 files/etc/uci-defaults/90-luci 写 uci luci.main.lang 实现

# ---------- 基础网络 ----------
CONFIG_PACKAGE_luci-app-firewall=y
# PassWall 必须用 dnsmasq-full（需要 ipset/nftset 与 --conf-dir）
CONFIG_PACKAGE_dnsmasq-full=y
# 上游加密改由 MosDNS 的 DoH 负责（dnsmasq 只做缓存与转发），不再需要编 DNSSEC
CONFIG_PACKAGE_dnsmasq_full_dnssec=n
# MosDNS 的 DoH 要校验证书：没有 CA 包会一直校验失败、退回明文（省不得）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：ipv6helper 上游已删除，改用原生组件
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ---------- 无线 ----------
# 这两个包平时由目标 profile 的 DEFAULT_PACKAGES 带入，但"默认带上"不等于"一定有"：
# 缺 wireless-regdb 时 country=CN 会设置失败，cfg80211 只能退回 world 法规域 ——
# 2.4G 发射功率被压到很低（穿墙更差），5G 部分信道直接不可用（时有时无）。
CONFIG_PACKAGE_wireless-regdb=y
# iw：wifi-doctor 诊断、手动切信道都要用（约 60KB，值得带）
CONFIG_PACKAGE_iw=y

# ---------- TurboACC（luci feed 已无此包，workflow 从上游克隆） ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
# 全锥 NAT 依赖 kmod-nft-fullcone，feeds 不一定有；确认存在后再改 y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV=n
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---------- 内存防溢出 ----------
# zram-swap 是 core 包，依赖里自带 kmod-zram
CONFIG_PACKAGE_zram-swap=y

# ---------- PassWall + Xray ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# GeoData 关掉：它只提供 geoip.dat(135KB) 与 geosite.dat(10.9MB) 两个二进制库。
# 本固件分流全用文本规则（gfwlist / chnlist / chnroute），不吃 geo 库；关掉之后
# PassWall 里 geoip:/geosite: 那几类规则不可用，其余功能不受影响。
# 省下约 3MB 闪存（10.9MB 的 geosite.dat 压缩后），xray 启动也少读一份大文件。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
# mt7621(mipsel) 上这两项默认为 y，纯 Xray 用户关掉可省 6~8MB
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=n
# Geoview 保持 n：它的作用是把 geosite:CATEGORY-ADS-ALL 这类规则展开成域名表，
# 但本固件不带 geosite.dat（见下节），装了也没有数据可用；去广告由 MosDNS 的
# 纯域名集合负责，见 build-immortalwrt.yml 的 K 节。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Brook=n
CONFIG_PACKAGE_xray-core=y
# nftables 透明代理链（passwall 会自动带，显式写出便于审计）
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
# MosDNS：去广告（域名集合）+ 上游加密（DoH）都靠它，显式写出便于审计。
# 只装二进制包；luci-app-mosdns 不装（它的依赖会把 10.9MB 的 geosite.dat 拉回来）
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

# ---------- GeoData：不编入（轻量化，已移除）----------
# v2ray-geoip / v2ray-geosite 不是写死的依赖：luci-app-passwall/Makefile 第 45-48 行
# 写的是 +PACKAGE_..._INCLUDE_V2ray_Geodata:v2ray-geoip / :v2ray-geosite 这类条件依赖，
# 所以上面把 INCLUDE_V2ray_Geodata 改成 n 之后，这两个包根本不会被拉进镜像。
# 体积：geoip-only-cn-private.dat 约 135KB，geosite.dat 约 10.9MB。
# 本固件用文本规则分流，只需要 gfwlist / chnlist / chnroute，不写这两个包名。
# 想恢复 geo 规则：把 INCLUDE_V2ray_Geodata 改回 y 即可，不必恢复本节。

# ---------- USB 存储与局域网共享 (ksmbd) ----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# 国内 U 盘常见的 GBK 文件名
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# ---------- USB 网络共享 / 随身 WiFi ----------
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbmuxd=y

# ---------- USB 打印 (p910nd) ----------
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
