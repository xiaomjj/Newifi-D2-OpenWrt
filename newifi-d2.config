# ============================================================
#  ImmortalWrt 24.10 + sing-box(自研面板) + SQM —— newifi-d2
#  目标分支: openwrt-24.10 (ramips/mt7621, 内核 6.6, opkg)
#  分支结论（2026-11-23 定型，别再改回去）：留在 24.10。
#    · cake/SQM 不需要 25.12：kmod-sched-core 的 KCONFIG 会把 CONFIG_NET_CLS 带进 24.10 内核，
#      cake / ifb 照样可加载（构建第 12 步硬校验，刷机后 fw-selftest 再确认一次）。
#    · 25.12（内核 6.12）在 mt7621 + mt7603 上 2.4G AP 不发信标（驱动级，扫不到 SSID），
#      这是回退的唯一硬理由；另外 24.10 用 opkg，脚本与包名全部按 opkg 写。
#  回滚成 25.12：REPO_BRANCH 与 feeds 三行改回去，并接受 2.4G AP 不可用。
#  说明: 本文件只写"真实存在"的 Kconfig 符号；不存在的符号会被
#        make defconfig 静默丢弃，本仓库 workflow 会做硬性校验。
#  核对记录（2026-11-22）: 原文件 102 个符号曾对照 openwrt-24.10 源码核对（现存 101 个）；
#        升到 25.12 后已单独核对新增的 SQM 相关符号（kmod-sched-core/cake/ifb、tc-full、
#        iptables-nft、iptables-mod-ipopt、sqm-scripts、luci-app-sqm、kmod-nft-fullcone）。
#        其余符号若在 25.12 里被改名，构建第 7 步的硬校验会直接报红，不会产出残缺固件。
#        - 34 个 kmod-* → 主仓库 package/kernel/**/*.mk + target/linux/*/modules.mk 的 KernelPackage/ 定义
#        - luci-app-passwall 13 个 INCLUDE_* → feeds/luci applications/luci-app-passwall/Makefile（25.12.16）
#        - TurboACC 已整体移除（2026-11-22），不再有 INCLUDE_* 符号需要核对
#        本轮修掉 2 个"不存在的符号"：CONFIG_LUCI_LANG_zh-cn（应为 zh_Hans）、
#        CONFIG_PACKAGE_usb-modeswitch（24.10 的 feeds 里已无此包）。
# ============================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---------- 构建选项 ----------
# ccache 不打开的话，workflow 里缓存 .ccache 完全是空转
CONFIG_CCACHE=y
# 小闪存必开：剥离内核用不到的导出符号
CONFIG_STRIP_KERNEL_EXPORTS=y

# ---------- LuCI 与中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
# 语言开关的符号是 CONFIG_LUCI_LANG_<po 目录名>（luci.mk: config LUCI_LANG_$(lang)，
# $(lang) 取自 applications/*/po/ 与 modules/*/po/ 下的目录名）。24.10 的 luci 只有
# zh_Hans（简体中文），没有 zh-cn —— zh-cn 只是 luci.mk 里的 LC 别名
# （LUCI_LC_ALIAS.zh_Hans=zh-cn），只出现在 i18n【包名】里，不是 Kconfig 符号。
# 写成 CONFIG_LUCI_LANG_zh-cn 会被 defconfig 静默丢弃，表现是"只有下面点名的几个
# 页面是中文，其余页面回落英文"。
CONFIG_LUCI_LANG_zh_Hans=y
# 注意：下面这些 i18n【包名】里的 zh-cn 是对的，别改成 zh_Hans —— 包名由
# luci-i18n-$(basename)-$(别名) 生成，别名就是 zh-cn。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
# 默认语言不用 CONFIG_LUCI_DEFAULT_LANG（不是 Kconfig 符号），
# 由 files/etc/uci-defaults/90-luci 写 uci luci.main.lang 实现

# ---------- 基础网络 ----------
CONFIG_PACKAGE_luci-app-firewall=y
# 下面这几个本就在 DEFAULT_PACKAGES.router / DEFAULT_PACKAGES 里，显式写出只为
# 一眼能审计到：firewall4 + nftables 是 fw4 与自研 nft 表（table inet singbox）的地基，
# uclient-fetch + libustream-openssl 是 rule-refresh 手动刷规则的 HTTPS 下载通道。
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_libustream-openssl=y
# jsonfilter：singbox-ctl 用它解析 sing-box / Xray JSON 订阅（base 里已有，显式写出便于审计）
CONFIG_PACKAGE_jsonfilter=y
# curl：订阅下载 + SOCKS 出口连通性测试（singbox-ctl sub-import / test 都靠它）
CONFIG_PACKAGE_curl=y
# dnsmasq-full：MosDNS 在前、dnsmasq 只做缓存与下发，但审计按 full 校验，且要 --conf-dir
CONFIG_PACKAGE_dnsmasq-full=y
# dnsmasq 与 dnsmasq-full 是同一份源码的两个 VARIANT（dnsmasq-full 里 PROVIDES:=dnsmasq），
# 两个都 =y 会让镜像里塞进两份 /usr/sbin/dnsmasq。默认变体（nodhcpv6）显式关掉。
# CONFIG_PACKAGE_dnsmasq is not set
# 上游加密改由 MosDNS 的 DoH 负责（dnsmasq 只做缓存与转发），不再需要编 DNSSEC
CONFIG_PACKAGE_dnsmasq_full_dnssec=n
# dnsmasq 的 nftset（nftables 集合回填）原本只给 PassWall 的域名分流用；
# PassWall 已移除、全树无 nftset= 配置，留着它白白拉进 nftables-json。
# 显式关掉（省闪存，也避免以后有人误以为还有 nftset 分流在跑）。
CONFIG_PACKAGE_dnsmasq_full_nftset=n
# MosDNS 的 DoH 要校验证书：没有 CA 包会一直校验失败、退回明文（省不得）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
# IPv6：ipv6helper 上游已删除，改用原生组件
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ---------- 无线 ----------
# 这两个包平时由目标 profile 的 DEFAULT_PACKAGES 带入，但"默认带上"不等于"一定有"：
# 缺 wireless-regdb 时 country=CN 会设置失败，cfg80211 只能退回 world 法规域 ——
# 2.4G 发射功率被压到很低（穿墙更差），5G 部分信道直接不可用（时有时无）。
CONFIG_PACKAGE_wireless-regdb=y
# iw：wifi-doctor 诊断、手动切信道都要用（约 60KB，值得带）
CONFIG_PACKAGE_iw=y

# ---------- TurboACC 已移除（2026-11-22）：它只是 LuCI 界面 ----------
# sw_flow/hw_flow 在中继模式下本来就被 relay-tune 强制关闭；sfe/hw 加速本镜像没有对应内核模块。
# 真正用到的两项各自独立：BBR = CONFIG_PACKAGE_kmod-tcp-bbr（下方已有），
#                     全锥 NAT = CONFIG_PACKAGE_kmod-nft-fullcone（SQM 段落里已显式编入）。
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---------- 内存防溢出 ----------
# zram-swap 是 core 包，依赖里自带 kmod-zram
CONFIG_PACKAGE_zram-swap=y

# ---------- 代理：sing-box（透明代理；DNS 仍归 MosDNS） ----------
# 内核 sing-box 由 build-immortalwrt.yml 构建期下载（OpenWrt 官方 sing-box-tiny ipk 解包），
# 不走 .config、不走 Go 工具链；这里只保留它运行需要的用户态与内核组件。
#
# 为什么删掉 PassWall / xray-core（2026-11-22 决定）：
#   · 面板已自研（服务 → sing-box），两套透明代理只会抢 nft 规则；
#   · feeds 的 xray-core 压缩后约 5MB，和 sing-box（32MB）一起塞 28MB 的 rootfs 会爆；
#   · 想恢复 PassWall：把下面注释掉的四项改回 y，并把 workflow 第 9 步的分流名单
#     重新指回 /usr/share/passwall/rules/proxy_host（git 历史里有原版）。
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_xray-core is not set
# chinadns-ng / dns2socks 只是 PassWall 的 DNS 分流件，随它一起去掉
# （本固件的 DNS 分流由 MosDNS 独立完成，不依赖这两个）
# nftables 透明代理地基：sing-box 的 tproxy / redirect 需要它们
# ip-full：singbox-ctl 的 nft 脚本要用 ip rule / ip route 做策略路由（UDP tproxy），busybox 的 ip 对 table 支持不全
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
# kmod-tun：sing-box 的 TUN 出站（本固件用 TPROXY，保留只是防止以后想切 TUN 还要重编内核）
CONFIG_PACKAGE_kmod-tun=y
# kmod-inet-diag：sing-box 的按进程匹配（process 规则）需要；体积很小，先编进来备用
CONFIG_PACKAGE_kmod-inet-diag=y
# MosDNS：去广告（域名集合）+ 上游加密（DoH）都靠它，显式写出便于审计。
# 只装二进制包；luci-app-mosdns 不装（它的依赖会把 10.9MB 的 geosite.dat 拉回来）
CONFIG_PACKAGE_mosdns=y

# ---------- USB 存储与局域网共享 (ksmbd) ----------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# 国内 U 盘常见的 GBK 文件名
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# ---------- USB 网络共享 / 随身 WiFi ----------
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
# usb-modeswitch：openwrt-24.10 这一代的 feeds 里已经没有这个包了（packages 与主仓库
# 全树都搜不到 utils/usb-modeswitch），写了也只会被 defconfig 静默丢弃，所以不写。
# 3G/4G 上网卡走下面的 qmi / mbim / ncm 直连，不依赖 modeswitch 切模式。
CONFIG_PACKAGE_usbmuxd=y

# ---------- USB 打印 (p910nd) ----------
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y

# ---------- SQM：唯一能治 bufferbloat 的方案（2026-11-22 定案）----------
# 现场实测（jitter/排队）：满载时 路由器→223.5.5.5 从 18 ms 涨到 平均 317 ms / 峰值 1113 ms，
# PC 端 70~170 ms；表现是"一开下载，游戏和视频通话就爆延迟"。排队发生在上游 CPE 与无线空口，
# 只能在本地整形（cake）才能消掉。
# 为什么必须编进镜像：当前 SNAPSHOT 源把 kmod 裁到只剩 111 个，缺 kmod-sched-core / cake / ifb，
# 连 `tc` 都因依赖不满足装不上（tc-tiny Depends: kmod-sched-core），于是整台机器做不了任何整形。
# 为什么带上 iptables-nft + iptables-mod-ipopt：sqm-scripts 1.6 的 Depends 写死了
# iptables + iptables-mod-ipopt。24.10 里已经没有名为 iptables 的包，该能力由 iptables-nft
# 提供（Provides: iptables）；符号写错会被 defconfig 静默丢弃，下面的硬校验就会报红。
# 默认不启用整形：刷完先测真实上下行，再按 README 的数值开（设高了没效果、设低了掉速）。
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
# 全锥 NAT 的内核模块显式编入：旧配置只靠 luci-app-turboacc 的隐含依赖，
# 一旦上游改了 DEPENDS 就会被静默丢掉，而 92-services 明确要打开 fullcone_nat。
CONFIG_PACKAGE_kmod-nft-fullcone=y
