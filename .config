# 目标架构配置 (Newifi-D2 / MediaTek MT7621)
CONFIG_target_ramips=y
CONFIG_target_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_device_d-team_newifi-d2=y

# 系统与界面优化
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# USB 存储及文件系统支持 (用于外接硬盘/U盘)
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_ntfs3-mount=y

# 网络打印机支持 (P910nd 服务)
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y

# PassWall 科学上网主程序及界面
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 核心组件与依赖支持 (包含 sing-box 核心)
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_xray-core=y

# WWAN / 4G / 5G 模块与 USB 拨号驱动支持
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y

# WWAN 拨号工具与中继管理组件
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-qmi=y

# 无线中继 / Client 客户端模式工具 (用于连接上级 WiFi 中继上网)
CONFIG_PACKAGE_wpad-openssl=y

# 默认局域网 IP 地址修改 (避免与主流光猫网段 192.168.1.1 冲突，改为 192.168.2.1)
CONFIG_PACKAGE_uci=y
# (注：若需修改网段，可在编译成功后通过网页后台直接更改)
