# ==========================================
# 0. 强制全局架构锁（防跳至其他架构）
# ==========================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_BOARD="ramips"
CONFIG_TARGET_SUBTARGET="mt7621"

# ==========================================
# 1. 硬件精准锁定：Newifi D2
# ==========================================
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ==========================================
# 2. 网络与中文汉化基础设定
# ==========================================
CONFIG_LAN_IP_ADDR="192.168.2.1"
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ==========================================
# 3. 界面主题美化（使用 OpenWrt 官方默认主题）
# ==========================================
# 默认使用系统自带默认主题

# ==========================================
# 4. 科学上网核心、底层强依赖与完整中文汉化（PassWall + Sing-Box）
# ==========================================
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_libselinux=y
CONFIG_PACKAGE_libstdcpp=y

# PassWall 及核心组件
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_I18n_chinese=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_sing-box=y

# ==========================================
# 5. USB 核心驱动、移动硬盘挂载与文件系统支持（NTFS/FAT32）
# ==========================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y

# ==========================================
# 6. USB 打印机与网络打印服务（P910nd 打印服务器）
# ==========================================
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-usb-printer=y

# ==========================================
# 7. WWAN 蜂窝网络 / 4G/5G 模块与手机 USB 共享支持
# ==========================================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
